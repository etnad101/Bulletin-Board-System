<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="BoardController">
   
   <center>
      <ScrollPane style="-fx-background-color: #f0f0f0;" BorderPane.alignment="CENTER">
         <content>
            <Pane fx:id="boardPane" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 1;" />
         </content>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </ScrollPane>
   </center>

   <right>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" right="10.0" top="11.0" />
         </padding>
         <children>
            <HBox spacing="5.0">
               <children>
                  <TextField fx:id="xInput" alignment="CENTER" prefHeight="35.0" prefWidth="70.0" promptText="&lt;x&gt;" />
                  <TextField fx:id="yInput" alignment="CENTER" prefHeight="35.0" prefWidth="70.0" promptText="&lt;y&gt;" />
                  <ComboBox fx:id="colorInput" prefHeight="35.0" prefWidth="123.0" promptText="Color" />
               </children>
            </HBox>

            <TextField fx:id="messageInput" alignment="CENTER" prefHeight="34.0" prefWidth="275.0" promptText="&lt;message&gt;" />

            <Button fx:id="postBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="44.0" prefWidth="275.0" text="Post">
               <VBox.margin>
                  <Insets bottom="-10.0" top="30.0" />
               </VBox.margin>
               <font>
                  <Font name="Arial Bold" size="13.0" />
               </font>
            </Button>

            <HBox spacing="5.0">
               <children>
                  <Button fx:id="pinBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" prefWidth="125.0" text="Pin" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="unpinBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" prefWidth="125.0" text="Unpin" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>

            <HBox spacing="5.0">
               <children>
                  <Button fx:id="getBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" prefWidth="125.0" text="Get" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="getPinsBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" prefWidth="125.0" text="Get PINS" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>

            <HBox spacing="5.0">
               <children>
                  <Button fx:id="shakeBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="50.0" prefWidth="125.0" text="SHAKE!" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Button>
                  <Button fx:id="clearBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="50.0" prefWidth="125.0" text="Clear" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>

            <Button fx:id="refreshBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="94.0" prefWidth="275.0" text="Refresh">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </right>

   <bottom>
      <HBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </padding>
         <children>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Dialog Box / Command Log">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                     <VBox.margin>
                        <Insets left="2.0" />
                     </VBox.margin>
                  </Label>
                  
                  <TextArea fx:id="dialogTextArea" editable="false" prefHeight="100.0" style="-fx-control-inner-background: black; -fx-text-fill: white; -fx-font-family: Consolas;" text="System Ready..." wrapText="true" />
                  
                  <TextField fx:id="commandInput" promptText="Enter raw command here (e.g. POST 10 10 red Hello) and press Enter" style="-fx-font-family: Consolas;">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </TextField>
               </children>
            </VBox>
            
            <Button fx:id="disconnectBtn" mnemonicParsing="false" prefHeight="135.0" prefWidth="150.0" text="Disconnect">
               <font>
                  <Font name="Arial Bold" size="16.0" />
               </font>
               <HBox.margin>
                  <Insets top="16.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>